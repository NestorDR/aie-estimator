# src/aie_estimator/.env.example

# Application settings
# App environment. Possible values: development, production, test
APP_ENV=development
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Values: true, false
JSON_LOGGING=true
ENABLE_FILE_LOGGING=false

# Server settings
SERVER_HOST=localhost
SERVER_PORT=8000

# AI settings
# Anthropic API key | No default (required if Anthropic is used)
ANTHROPIC_API_KEY=
# Gemini API key | No default (required if Gemini is used)
GEMINI_API_KEY=
# OpenAI API key | No default (required if OpenAI is used)
OPENAI_API_KEY=
# Model to use
LLM_MODEL=gpt-4o-mini

# Cache settings
# Inside docker-compose, REDIS_HOST should be set as redis.
# When running uvicorn locally, localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=86400

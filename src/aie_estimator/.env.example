# src/aie_estimator/.env.example

# Application settings
# App environment. Values: dev, prod, test
APP_ENV=dev
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Set Json format logging. Values: true, false
JSON_LOGGING=true
# Enables logging to a file (used to verify logging during the development/IDE phase). Values: true, file
ENABLE_FILE_LOGGING=false
# Enables OpenTelemetry distributed tracing and export to Arize Phoenix. Values: true, false
ENABLE_OTEL_TRACING=false
# OTLP collector endpoint | `http://localhost:4317` for dev | `http://phoenix:4317` for prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Server settings | `localhost` for dev environment | `0.0.0.0` for prod environment
SERVER_HOST=localhost
SERVER_PORT=8000

# AI settings
# Anthropic API key | No default (required if Anthropic is used)
ANTHROPIC_API_KEY=
# Gemini API key | No default (required if Gemini is used)
GEMINI_API_KEY=
# OpenAI API key | No default (required if OpenAI is used)
OPENAI_API_KEY=

# --- Session 3 — LiteLLM wrapper ----------------------------------------------
# Model or logical routing profile to use:
# - LiteLLM Router profiles (defined in llm_profiles.yml): `reasoner-fast` (low-latency/cost Tier 1) | `reasoner-deep` (deep reasoning Tier 2)
# - Direct vendor models (for `native` engine or fallback): `gpt-6-luna` (OpenAI) | `claude-haiku-5-5` (Anthropic)
LLM_MODEL=reasoner-fast
# LiteLLM cost map | true to use bundled local file | false to fetch latest from GitHub
LITELLM_LOCAL_MODEL_COST_MAP=true

# --- Session 3 — Streamlit transport ------------------------------------------
# Streamlit hits the FastAPI service over HTTP. Point this to wherever the
# estimator is reachable from the machine running streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Session 3 — Redis exact-match cache --------------------------------------
# Cache settings | `localhost` for dev environment | `redis` for prod environment
REDIS_HOST=localhost
REDIS_PORT=6379
# Exact cache settings
ENABLE_EXACT_CACHE=true
EXACT_CACHE_TTL=86400

# --- Session 4 — Active prompt template version (default: v1) -----------------
ACTIVE_PROMPT_VERSION=v1

# --- Session 4 — Semantic cache (redisvl + embeddings) ------------------------
# Cosine similarity threshold (0..1) above which a stored estimation is served
# as a cache hit. 0.92 is conservative; lower threshold = more recall, more
# false positives. Affines with the chosen embedding model.
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=86400
# When true, the cache logs would-be hits but does NOT serve them, when false YES.
# Useful to calibrate the threshold against production traffic before flipping on.
SEMANTIC_CACHE_LOG_ONLY=false

# --- Pre-Session 05 — Attachment ingestion budgets ----------------------------
MAX_ATTACHMENTS_PER_TURN=5
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_CHARS=12000
MAX_TOTAL_ATTACHMENT_CHARS=30000
SUPPORTED_ATTACHMENT_EXTENSIONS=[".pdf",".docx",".txt",".md"]

# --- Pre-Session 05 — Conversational session lifecycle ------------------------
SESSION_MAX_TURNS=6
SESSION_TTL_SECONDS=86400
# .dockerignore
# This file excludes unnecessary files from the Docker build context.

# Exclude all files by default
*

# Explicitly include the source code, CLI scripts, and config
!src/
!scripts/
!pyproject.toml
!uv.lock
!README.md

#  Exclusions, even if they are inside !src/
# Python caches
**/__pycache__/
**/*$py.class
**/.env*